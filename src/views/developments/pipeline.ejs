<%- include('../partials/header') %>
<p class="eyebrow">Development activity</p><h1>The pipeline</h1><p class="lead">Projects grouped by their recorded planning status.</p><section class="pipeline"><% Object.entries(pipeline).forEach(([status, developments]) => { %><div class="pipeline-column"><h2><%= status %> <small>(<%= developments.length %>)</small></h2><% developments.forEach((development) => { %><a href="/developments/<%= development.development_id %>"><strong><%= development.project_name || 'Unnamed development' %></strong><span><%= development.properties?.municipality || 'Municipality not recorded' %></span><small><%= development.proposed_units ?? '—' %> units</small></a><% }) %></div><% }) %></section><% if (!Object.keys(pipeline).length) { %><p>The pipeline will appear as verified developments are added.</p><% } %>
<%- include('../partials/footer') %>
