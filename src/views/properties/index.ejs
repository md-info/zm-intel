<%- include('../partials/header') %>
<link rel="stylesheet" href="/property-media.css">
<p class="eyebrow">Zion database</p><h1>Property records</h1><p class="lead">Existing property conditions, source-backed facts, and their associated development activity.</p>
<form class="filters" method="get"><input aria-label="Search properties" name="q" value="<%= filters.term %>" placeholder="Search properties"><select aria-label="Municipality" name="municipality"><option value="">All municipalities</option><% municipalities.forEach((municipality) => { %><option value="<%= municipality %>" <%= filters.municipality === municipality ? 'selected' : '' %>><%= municipality %></option><% }) %></select><select aria-label="Property type" name="propertyType"><option value="">All property types</option><% propertyTypes.forEach((type) => { %><option value="<%= type.property_type_id %>" <%= filters.propertyTypeId === type.property_type_id ? 'selected' : '' %>><%= type.type_name %></option><% }) %></select><select aria-label="Property status" name="status"><option value="">All statuses</option><% propertyStatuses.forEach((status) => { %><option value="<%= status.property_status_id %>" <%= filters.statusId === status.property_status_id ? 'selected' : '' %>><%= status.status_name %></option><% }) %></select><button>Apply filters</button><a href="/properties">Clear filters</a></form>
<p class="result-count"><%= properties.length %> record<%= properties.length === 1 ? '' : 's' %></p>
<section class="list"><% properties.forEach((property) => { const image = (property.property_media || []).find((media) => media.is_primary) || property.property_media?.[0]; %><a class="list-item property-card" href="/properties/<%= property.property_id %>"><% if (image) { %><img class="property-card-image" src="<%= presentation.safeUrl(image.image_url) %>" alt="<%= image.alt_text || 'Street-level view of ' + (property.property_name || property.address_line_1) %>" loading="lazy"><% } else { %><div class="property-card-placeholder" aria-hidden="true">Property image pending</div><% } %><div class="property-card-body"><h2><%= property.property_name || property.address_line_1 %></h2><p><%= [property.address_line_1, property.municipality, property.province].filter(Boolean).join(', ') %></p><span><%= property.property_types?.type_name || 'Unclassified' %> · <%= property.property_statuses?.status_name || 'Unspecified' %></span><small>Last verified: <%= property.last_verified_at ? new Date(property.last_verified_at).toLocaleDateString() : 'Pending' %></small></div></a><% }) %></section>
<% if (!properties.length) { %><p>No records match these filters yet.</p><% } %>
<%- include('../partials/footer') %>
