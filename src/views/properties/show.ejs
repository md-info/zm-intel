<%- include('../partials/header') %>
<link rel="stylesheet" href="/property-profile.css">
<link rel="stylesheet" href="/property-media.css">
<link rel="stylesheet" href="/research-trail.css">

<%
  const hasMap = property.latitude !== null && property.latitude !== undefined && property.longitude !== null && property.longitude !== undefined;
  const developments = property.developments || [];
  const evidence = property.evidence || [];
  const primaryMedia = (property.property_media || []).find((media) => media.is_primary) || property.property_media?.[0];
  const isPresent = (value) => value !== null && value !== undefined && value !== '';
  const formatValue = (value, type) => {
    if (type === 'boolean') return value ? 'Yes' : 'No';
    if (type === 'date') return new Date(`${String(value).slice(0, 10)}T00:00:00`).toLocaleDateString();
    if (type === 'currency') return new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 }).format(Number(value));
    if (type === 'year') return String(value);
    if (type === 'number') return Number(value).toLocaleString('en-CA');
    if (type === 'sqft') return `${Number(value).toLocaleString('en-CA')} sq ft`;
    if (type === 'feet') return `${Number(value).toLocaleString('en-CA')} ft`;
    if (type === 'percent') return `${Number(value).toLocaleString('en-CA')}%`;
    if (type === 'acres') return `${Number(value).toLocaleString('en-CA')} acres`;
    if (type === 'kilometres') return `${Number(value).toLocaleString('en-CA')} km`;
    if (type === 'metres') return `${Number(value).toLocaleString('en-CA')} m`;
    return value;
  };
  const groups = [
    { title: 'Identification', fields: [
      ['Alternate name', 'alternate_property_name'], ['Parcel ID', 'parcel_id'], ['Secondary parcel ID', 'secondary_parcel_id'], ['Assessment roll number', 'assessment_roll_number'], ['Property identifier', 'property_identifier'], ['Legal description', 'legal_description']
    ] },
    { title: 'Location and site', fields: [
      ['Region', 'region'], ['Country', 'country'], ['Latitude', 'latitude'], ['Longitude', 'longitude'], ['Neighbourhood', 'neighborhood'], ['District', 'district'], ['Submarket', 'submarket'], ['Planning area', 'planning_area'], ['Census tract', 'census_tract'], ['School district', 'school_district'], ['Lot area', 'lot_area_sqft', 'sqft'], ['Lot area', 'lot_area_acres', 'acres'], ['Lot frontage', 'lot_frontage_ft', 'feet'], ['Lot depth', 'lot_depth_ft', 'feet'], ['Lot width', 'lot_width_ft', 'feet'], ['Lot shape', 'lot_shape'], ['Site coverage', 'site_coverage_pct', 'percent'], ['Buildable area', 'buildable_area_sqft', 'sqft'], ['Undeveloped area', 'undeveloped_area_sqft', 'sqft'], ['Waterfront', 'waterfront', 'boolean'], ['Waterfront frontage', 'waterfront_frontage_ft', 'feet'], ['Water body', 'water_body'], ['Corner lot', 'corner_lot', 'boolean']
    ] },
    { title: 'Building', fields: [
      ['Existing gross floor area', 'existing_gfa_sqft', 'sqft'], ['Building count', 'building_count', 'number'], ['Elevator count', 'elevator_count', 'number'], ['Primary building area', 'primary_building_area_sqft', 'sqft'], ['Gross building area', 'gross_building_area_sqft', 'sqft'], ['Rentable area', 'rentable_area_sqft', 'sqft'], ['Leasable area', 'leasable_area_sqft', 'sqft'], ['Net rentable area', 'net_rentable_area_sqft', 'sqft'], ['Above-grade area', 'above_grade_area_sqft', 'sqft'], ['Below-grade area', 'below_grade_area_sqft', 'sqft'], ['Basement area', 'basement_area_sqft', 'sqft'], ['Stories', 'stories', 'number'], ['Above-grade stories', 'above_grade_stories', 'number'], ['Below-grade stories', 'below_grade_stories', 'number'], ['Year built', 'year_built', 'year'], ['Year renovated', 'year_renovated', 'year'], ['Last major renovation', 'last_major_renovation_year', 'year'], ['Building condition', 'building_condition'], ['Construction type', 'construction_type'], ['Exterior material', 'exterior_material'], ['Foundation type', 'foundation_type'], ['Roof type', 'roof_type'], ['Roof year', 'roof_year', 'year'], ['Roof condition', 'roof_condition'], ['HVAC type', 'hvac_type'], ['Heating type', 'heating_type'], ['Cooling type', 'cooling_type'], ['Fuel type', 'fuel_type'], ['Electrical service', 'electrical_service'], ['Electrical capacity', 'electrical_capacity'], ['Plumbing type', 'plumbing_type'], ['Fire protection type', 'fire_protection_type'], ['Sprinkler system', 'sprinkler_system', 'boolean']
    ] },
    { title: 'Units and occupancy', fields: [
      ['Existing units', 'existing_units', 'number'], ['Residential units', 'residential_units', 'number'], ['Commercial units', 'commercial_units', 'number'], ['Retail units', 'retail_units', 'number'], ['Office units', 'office_units', 'number'], ['Industrial units', 'industrial_units', 'number'], ['Other units', 'other_units', 'number'], ['Occupied units', 'occupied_units', 'number'], ['Vacant units', 'vacant_units', 'number'], ['Occupancy rate', 'occupancy_rate', 'percent'], ['Average unit area', 'average_unit_area_sqft', 'sqft'], ['Studio units', 'studio_units', 'number'], ['One-bedroom units', 'one_bedroom_units', 'number'], ['Two-bedroom units', 'two_bedroom_units', 'number'], ['Three-bedroom units', 'three_bedroom_units', 'number'], ['Four-plus-bedroom units', 'four_plus_bedroom_units', 'number'], ['Unit mix', 'unit_mix_description']
    ] },
    { title: 'Parking and utilities', fields: [
      ['Parking spaces', 'parking_spaces', 'number'], ['Parking ratio', 'parking_ratio', 'number'], ['Surface parking', 'surface_parking_spaces', 'number'], ['Covered parking', 'covered_parking_spaces', 'number'], ['Underground parking', 'underground_parking_spaces', 'number'], ['Structured parking', 'structured_parking_spaces', 'number'], ['Garage spaces', 'garage_spaces', 'number'], ['Accessible parking spaces', 'accessible_parking_spaces', 'number'], ['EV parking spaces', 'ev_parking_spaces', 'number'], ['Public water', 'public_water', 'boolean'], ['Public sewer', 'public_sewer', 'boolean'], ['Storm sewer', 'storm_sewer', 'boolean'], ['Natural gas', 'natural_gas', 'boolean'], ['Electric service', 'electric_service', 'boolean'], ['Internet service', 'internet_service', 'boolean'], ['Fibre available', 'fiber_available', 'boolean'], ['Septic system', 'septic_system', 'boolean'], ['Well system', 'well_system', 'boolean'], ['Utility capacity notes', 'utility_capacity_notes']
    ] },
    { title: 'Zoning and development potential', fields: [
      ['Zoning code', 'zoning_code'], ['Zoning description', 'zoning_description'], ['Permitted uses', 'permitted_use'], ['Conditional uses', 'conditional_uses'], ['Current zoning compliance', 'current_zoning_compliance'], ['Future land use', 'future_land_use'], ['Planning designation', 'planning_designation'], ['Development designation', 'development_designation'], ['Density', 'density_units_per_acre', 'number'], ['Maximum density', 'maximum_density_units', 'number'], ['Maximum FAR', 'maximum_far', 'number'], ['Maximum height', 'maximum_height_ft', 'feet'], ['Maximum stories', 'maximum_stories', 'number'], ['Maximum site coverage', 'maximum_site_coverage_pct', 'percent'], ['Minimum lot area', 'minimum_lot_area_sqft', 'sqft'], ['Minimum frontage', 'minimum_frontage_ft', 'feet'], ['Front setback', 'front_setback_ft', 'feet'], ['Rear setback', 'rear_setback_ft', 'feet'], ['Side setback', 'side_setback_ft', 'feet'], ['Parking requirement', 'parking_requirement'], ['Parking minimum', 'parking_minimum', 'number'], ['Parking maximum', 'parking_maximum', 'number'], ['Development charges apply', 'development_charges_applicable', 'boolean'], ['Inclusionary zoning', 'inclusionary_zoning', 'boolean'], ['Heritage designation', 'heritage_designation', 'boolean'], ['Heritage status', 'heritage_status'], ['Development status', 'development_status'], ['Development stage', 'development_stage'], ['Development potential', 'development_potential'], ['Development opportunity', 'development_opportunity'], ['Redevelopment potential', 'redevelopment_potential', 'boolean'], ['Densification potential', 'densification_potential', 'boolean'], ['Expansion potential', 'expansion_potential', 'boolean'], ['Additional GFA potential', 'additional_gfa_potential_sqft', 'sqft'], ['Additional unit potential', 'additional_units_potential', 'number'], ['Additional buildable area', 'additional_buildable_area_sqft', 'sqft'], ['Development constraints', 'development_constraints'], ['Development notes', 'development_notes']
    ] },
    { title: 'Commercial, industrial, and access', fields: [
      ['Retail area', 'retail_area_sqft', 'sqft'], ['Office area', 'office_area_sqft', 'sqft'], ['Warehouse area', 'warehouse_area_sqft', 'sqft'], ['Industrial area', 'industrial_area_sqft', 'sqft'], ['Clear height', 'clear_height_ft', 'feet'], ['Loading docks', 'loading_docks', 'number'], ['Drive-in doors', 'drive_in_doors', 'number'], ['Grade-level doors', 'grade_level_doors', 'number'], ['Truck court', 'truck_court', 'boolean'], ['Rail access', 'rail_access', 'boolean'], ['Industrial power', 'industrial_power', 'boolean'], ['Road access', 'road_access'], ['Access type', 'access_type'], ['Transit access', 'transit_access', 'boolean'], ['Transit distance', 'transit_distance_m', 'metres'], ['Transit type', 'transit_type'], ['Highway access', 'highway_access', 'boolean'], ['Highway distance', 'highway_distance_km', 'kilometres']
    ] },
    { title: 'Amenities, accessibility, and environmental conditions', fields: [
      ['Accessible', 'accessible', 'boolean'], ['Barrier-free', 'barrier_free', 'boolean'], ['Accessible entrance', 'accessible_entrance', 'boolean'], ['Accessible elevator', 'accessible_elevator', 'boolean'], ['Accessible parking', 'accessible_parking', 'boolean'], ['Laundry', 'has_laundry', 'boolean'], ['Pool', 'has_pool', 'boolean'], ['Fitness facility', 'has_fitness_facility', 'boolean'], ['Rooftop', 'has_rooftop', 'boolean'], ['Balcony', 'has_balcony', 'boolean'], ['Terrace', 'has_terrace', 'boolean'], ['Yard', 'has_yard', 'boolean'], ['Storage', 'has_storage', 'boolean'], ['Security system', 'has_security_system', 'boolean'], ['Central air', 'has_central_air', 'boolean'], ['Backup generator', 'has_backup_generator', 'boolean'], ['Loading dock', 'has_loading_dock', 'boolean'], ['Dock', 'has_dock', 'boolean'], ['Fenced yard', 'has_fenced_yard', 'boolean'], ['Flood zone', 'flood_zone'], ['Floodplain', 'floodplain', 'boolean'], ['Environmental issue', 'environmental_issue', 'boolean'], ['Environmental status', 'environmental_status'], ['Contamination status', 'contamination_status'], ['Brownfield', 'brownfield', 'boolean'], ['Wetland', 'wetland', 'boolean'], ['Protected area', 'protected_area', 'boolean'], ['Endangered species constraint', 'endangered_species_constraint', 'boolean'], ['Soil condition', 'soil_condition'], ['Geotechnical condition', 'geotechnical_condition']
    ] },
    { title: 'Ownership, assessment, and taxes', fields: [
      ['Ownership type', 'ownership_type'], ['Tenure type', 'tenure_type'], ['Freehold', 'freehold', 'boolean'], ['Leasehold', 'leasehold', 'boolean'], ['Condominium', 'condominium', 'boolean'], ['Strata', 'strata', 'boolean'], ['Owner entity', 'owner_entity_name'], ['Assessed value', 'assessed_value', 'currency'], ['Assessed land value', 'assessed_land_value', 'currency'], ['Assessed building value', 'assessed_building_value', 'currency'], ['Assessment year', 'assessment_year', 'year'], ['Annual property tax', 'annual_property_tax', 'currency'], ['Tax rate', 'tax_rate', 'percent'], ['Tax per square foot', 'tax_per_sqft', 'currency'], ['Tax status', 'tax_status']
    ] },
    { title: 'Market and operating performance', fields: [
      ['Asking price', 'asking_price', 'currency'], ['Current market value', 'current_market_value', 'currency'], ['Last sale price', 'last_sale_price', 'currency'], ['Last sale date', 'last_sale_date', 'date'], ['Price per square foot', 'price_per_sqft', 'currency'], ['Current annual rental income', 'current_annual_rental_income', 'currency'], ['Current annual other income', 'current_annual_other_income', 'currency'], ['Gross potential income', 'gross_potential_income', 'currency'], ['Effective gross income', 'effective_gross_income', 'currency'], ['Current NOI', 'current_noi', 'currency'], ['Annual insurance cost', 'annual_insurance_cost', 'currency'], ['Annual utilities cost', 'annual_utilities_cost', 'currency'], ['Annual maintenance cost', 'annual_maintenance_cost', 'currency'], ['Annual management cost', 'annual_management_cost', 'currency'], ['Annual other operating expenses', 'annual_other_operating_expenses', 'currency'], ['Expense ratio', 'expense_ratio', 'percent'], ['Average rent per unit', 'average_rent_per_unit', 'currency'], ['Average rent per square foot', 'average_rent_per_sqft', 'currency'], ['Market rent per unit', 'market_rent_per_unit', 'currency'], ['Market rent per square foot', 'market_rent_per_sqft', 'currency'], ['Indicated cap rate', 'indicated_cap_rate', 'percent']
    ] },
    { title: 'Existing financing', fields: [
      ['Existing debt amount', 'existing_debt_amount', 'currency'], ['Existing mortgage amount', 'existing_mortgage_amount', 'currency'], ['Existing mortgage rate', 'existing_mortgage_rate', 'percent'], ['Mortgage maturity', 'existing_mortgage_maturity_date', 'date'], ['Existing debt type', 'existing_debt_type'], ['Lender', 'lender_name']
    ] },
    { title: 'Latest development activity', note: 'This is a property-level snapshot of the most recently recorded development activity. See the linked development for the complete project record and its sources.', fields: [
      ['Planning application status', 'planning_application_status'], ['Planning application number', 'planning_application_number'], ['Site plan status', 'site_plan_status'], ['Building permit status', 'building_permit_status'], ['Building permit number', 'building_permit_number'], ['Development approval status', 'development_approval_status'], ['Development approval date', 'development_approval_date', 'date'], ['Permit date', 'permit_date', 'date'], ['Construction start', 'construction_start_date', 'date'], ['Construction completion', 'construction_completion_date', 'date']
    ] },
  ];
  const evidenceByField = evidence.reduce((fields, citation) => {
    if (!citation.field_name) return fields;
    if (!fields[citation.field_name]) fields[citation.field_name] = [];
    fields[citation.field_name].push(citation);
    return fields;
  }, Object.create(null));
%>

<% if (hasMap) { %><link rel="stylesheet" href="/map.css"><% } %>
<p class="eyebrow"><%= property.property_types?.type_name || 'Property' %></p>
<h1><%= property.property_name || property.address_line_1 %></h1>
<p class="lead"><%= [property.address_line_1, property.address_line_2, property.municipality, property.province, property.postal_code].filter(Boolean).join(', ') %></p>
<section class="details"><div><strong>Status</strong><span><%= property.property_statuses?.status_name || 'Unspecified' %></span></div><% if (property.current_use) { %><div><strong>Current use</strong><span><%= property.current_use %></span></div><% } %><div><strong>Last verified</strong><span><%= property.last_verified_at ? new Date(property.last_verified_at).toLocaleDateString() : 'Pending' %></span></div></section>

<% if (primaryMedia) { %><section class="profile-section property-hero-media"><img src="<%= presentation.safeUrl(primaryMedia.image_url) %>" alt="<%= primaryMedia.alt_text || 'Street-level view of ' + (property.property_name || property.address_line_1) %>" loading="eager"><div><p class="eyebrow"><%= primaryMedia.media_type %> image</p><% if (primaryMedia.captured_at) { %><p class="metadata">Captured <%= new Date(`${primaryMedia.captured_at}T00:00:00`).toLocaleDateString() %></p><% } %><% if (primaryMedia.source_url) { %><a href="<%= presentation.safeUrl(primaryMedia.source_url) %>" target="_blank" rel="noreferrer">Image source ↗</a><% } else if (primaryMedia.source_name) { %><p class="metadata"><%= primaryMedia.source_name %></p><% } %></div></section><% } %>

<% if (hasMap) { %><section class="profile-section"><h2>Location</h2><div id="property-map" class="property-map" aria-label="Map showing the property location"></div><p class="map-note">Location is based on the coordinates recorded for this property.</p></section><% } %>
<% if (property.description) { %><section class="profile-section"><h2>Profile</h2><p class="article-content"><%= property.description %></p></section><% } %>

<p class="record-note">Existing property conditions are shown below. Proposed changes belong to the linked development. Blank fields are omitted; “No” and zero are recorded values, not missing data.</p>
<nav class="section-nav" aria-label="Property sections"><% groups.forEach((group, index) => { if (group.fields.some(([,key]) => isPresent(property[key]))) { %><a href="#property-section-<%= index %>"><%= group.title %></a><% } }) %><a href="#sources-and-evidence">Sources and evidence</a></nav>
<% groups.forEach((group,index) => { const fields = group.fields.filter(([, key]) => isPresent(property[key])); if (fields.length) { %>
  <section class="profile-section" id="property-section-<%= index %>"><h2><%= group.title %></h2><% if (group.note) { %><p class="metadata"><%= group.note %></p><% } %><dl class="property-facts"><% fields.forEach(([label, key, type]) => { const citations = evidenceByField[key] || []; const tooltipId = `evidence-${key}`; %><div class="property-fact<%= citations.length ? ' property-fact-cited' : '' %>" <% if (citations.length) { %>tabindex="0" aria-describedby="<%= tooltipId %>"<% } %>><dt><%= label %><% if (citations.length) { %><span class="fact-evidence-indicator" aria-hidden="true">Evidence</span><span class="sr-only">Evidence available</span><% } %></dt><dd><% if (type === 'url') { %><a href="<%= presentation.safeUrl(property[key]) %>" target="_blank" rel="noreferrer">Open source ↗</a><% } else { %><%= formatValue(property[key], type) %><% } %></dd><% if (citations.length) { %><aside class="fact-evidence-tooltip" id="<%= tooltipId %>" role="tooltip"><p class="fact-evidence-heading">Evidence and source</p><% citations.forEach((citation) => { const source = citation.sources || {}; const sourceTitle = source.document_title || source.source_name || 'Source document'; %><div class="fact-citation"><strong><%= sourceTitle %></strong><% if (citation.evidence_text) { %><p><%= citation.evidence_text %></p><% } %><div class="fact-citation-footer"><% if (source.url) { %><a href="<%= presentation.safeUrl(source.url) %>" target="_blank" rel="noreferrer">Open source ↗</a><% } %><% if (citation.verified_at) { %><span>Verified <%= new Date(citation.verified_at).toLocaleDateString('en-CA') %></span><% } %></div></div><% }) %></aside><% } %></div><% }) %></dl></section>
<% } }) %>

<%- include('../partials/research-trail', { evidence }) %>
<%- include('../partials/record-facts', { record: property, heading: 'Record provenance', fields: [['Data source','data_source'],['Source reference','source_reference'],['Source URL','source_url'],['Source date','source_date'],['Data as of','data_as_of_date'],['Verification method','verification_method'],['Verification status','verification_status'],['Data confidence','data_confidence'],['Data quality score','data_quality_score'],['Updated','updated_at']] }) %>

<section class="profile-section"><h2>Linked developments</h2><% if (developments.length) { %><ul><% developments.forEach((development) => { %><li><a href="/developments/<%= development.development_id %>"><%= development.project_name || 'Unnamed development' %></a> — <%= development.development_statuses?.status_name || 'Unspecified' %></li><% }) %></ul><% } else { %><p>No linked developments yet.</p><% } %></section>

<% if (hasMap) { %><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script><script>const latitude = <%- JSON.stringify(Number(property.latitude)) %>; const longitude = <%- JSON.stringify(Number(property.longitude)) %>; const map = L.map('property-map', { scrollWheelZoom: false }).setView([latitude, longitude], 15); L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map); L.marker([latitude, longitude], { icon: L.divIcon({ className: 'zion-map-marker', iconSize: [18, 18], iconAnchor: [9, 9] }) }).addTo(map).bindTooltip(Object.assign(document.createElement('span'), { textContent: <%- JSON.stringify(property.property_name || property.address_line_1).replace(/</g, '\\u003c') %> }));</script><% } %>

<%- include('../partials/footer') %>
